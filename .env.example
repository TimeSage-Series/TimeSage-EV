# TimeSage-EV environment. Copy to .env, fill in only what you use, and load
# it into your shell — nothing reads .env by itself:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Only secrets and endpoints go here. Which agent model and judge to use is an
# experiment setting: put it in a config file (experiments/example.yaml) and
# pass it with `evsandbox ... --config`.
#
# Offline runs need none of this: evsandbox defaults to the mock judge, and
# the agent needs no key until you pick an lm_provider.

# --- LLM API keys -----------------------------------------------------------
# Read by the judge (--judge anthropic|openrouter) and by agents
# (--agent-arg lm_provider=anthropic|openai|openrouter).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Self-hosted OpenAI-compatible models -----------------------------------
# For --judge spike and lm_provider=spike (vLLM, SGLang, ...). Either a YAML
# file mapping model names to base URLs,
#
#   models:
#     my-qwen-70b: https://qwen.internal.example/v1
#
# or one endpoint used for every model name.
TIMESAGE_MODELS_CONFIG=
SPIKE_BASE_URL=
SPIKE_API_KEY=EMPTY

# --- Maintainer: re-downloading scenario data -------------------------------
# Free keys: https://quickstats.nass.usda.gov/api | https://www.eia.gov/opendata/
NASS_API_KEY=
EIA_API_KEY=

# --- Optional; leave commented out to keep the default ----------------------
# TIMESAGE_EVAL_CACHE=~/.cache/timesage_eval/judge_cache   # judge response cache
# TIMESAGE_DATA_ROOT=scenarios_hf      # data tree the maintainer pipeline writes
# TIMESAGE_SEARXNG=http://127.0.0.1:8888   # web search, see `evsandbox searxng up`
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
